# server/.env.example
# Copy to .env and fill in your values
# NEVER commit .env to version control!

# Application
APP_NAME="Pulse API"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Security (REQUIRED - generate with: openssl rand -hex 32)
SECRET_KEY=your-32-char-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Database (choose ONE - Render will override DATABASE_URL)
# Option A: Render PostgreSQL (internal)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Option B: Supabase (recommended for production - use connection pooler)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:6543/postgres?pgbouncer=true

# Option C: Local development (SQLite)
# DATABASE_URL=sqlite:///./pulse.db

# Redis (optional - for caching/background jobs)
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array string)
CORS_ORIGINS_JSON='["https://your-project.vercel.app", "https://app.yourdomain.com"]'

# GitHub OAuth (required for GitHub integration)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# AI Providers (at least one required for draft generation)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...