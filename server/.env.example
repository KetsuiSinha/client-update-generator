# Pulse API - Environment Configuration
# Copy this file to .env and fill in actual values

# Application
APP_NAME=Pulse API
API_V1_PREFIX=/api/v1
DEBUG=True

# Security - MUST be set to strong random values
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for token storage - MUST be 32 bytes base64-encoded
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-valid-fernet-key

# Database
DATABASE_URL=sqlite:///./pulse.db
# For production: DATABASE_URL=postgresql://user:pass@host:port/db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS
# Origins that can access the API - override with comma-separated JSON array
CORS_ORIGINS=["http://localhost:3000"]

# OAuth providers - set client IDs/secrets from developer consoles
# GitHub
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
# Linear
LINEAR_CLIENT_ID=change-me
LINEAR_CLIENT_SECRET=change-me
# Slack
SLACK_CLIENT_ID=change-me
SLACK_CLIENT_SECRET=change-me
# Trello
TRELLO_API_KEY=change-me
TRELLO_API_SECRET=change-me